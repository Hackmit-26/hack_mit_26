{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": null,
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "dist/fixtures/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "outputDirectory": "public"
}
