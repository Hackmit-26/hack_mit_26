# Server
PORT=8080
API_BASE_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000

# Supabase (from the DB owner). DB_MODE=postgres hydrates the working set from their tables at
# boot and mirrors gift-flow writes back; DB_MODE=memory runs entirely off fixtures/.
DB_MODE=memory
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI. LLM_MOCK=true keeps the whole pipeline deterministic and offline.
LLM_PROVIDER=anthropic
LLM_MOCK=true
LLM_API_KEY=
# Only needed for an org-level key. One created inside a workspace already names it; leave blank.
LLM_WORKSPACE_ID=
LLM_MODEL_TEXT=claude-sonnet-4-6
LLM_MODEL_VISION=claude-sonnet-4-6
LLM_MODEL_COPY=claude-opus-4-6
# Embeddings default to LLM_MOCK, so a real LLM_API_KEY without EMBED_API_KEY hard-fails the gift
# pipeline. Set this when you have one but not the other.
EMBED_MOCK=true
EMBED_PROVIDER=openai
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=512

# Products
PRODUCT_SEARCH_MODE=catalogue
PRODUCT_SEARCH_API_KEY=

# Visa
VISA_MODE=mock
VISA_BASE_URL=https://sandbox.api.visa.com
VISA_USER_ID=
VISA_PASSWORD=
VISA_CERT_PATH=./secrets/cert.pem
VISA_KEY_PATH=./secrets/key.pem
VISA_CA_PATH=./secrets/visa-sandbox-ca.pem
VISA_ACQUIRING_BIN=
VISA_ACQUIRER_COUNTRY_CODE=840
VISA_TEST_CARDS_JSON=./secrets/test-cards.json

# Message Level Encryption. Leave VISA_MLE_KEY_ID blank unless the Visa project has MLE on -
# the symptom is every Visa Direct call answering 400 9125 while /vdp/helloworld answers 200.
# Both values come from the project dashboard under Credentials > Message Level Encryption.
VISA_MLE_KEY_ID=
VISA_MLE_SERVER_CERT_PATH=./secrets/mle-server-cert.pem
# Defaults to VISA_KEY_PATH: Visa encrypts responses to our client certificate.
VISA_MLE_PRIVATE_KEY_PATH=

# Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Social Shopping
WEBAUTHN_ORIGIN=http://localhost:3000
PASSKEY_MODE=confirm

# Demo
DEMO_MODE=false

# Jobs
JOBS_ENABLED=true
DEADLINE_SWEEP_INTERVAL_MS=60000
