# Copy to .env.local. Both values are inlined into the client bundle at build time.

# Where the Fastify backend is listening. The fast demo server runs on 8081:
#   PORT=8081 DB_MODE=memory DEMO_MODE=true LLM_MOCK=true VISA_MODE=mock pnpm dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Who a fresh page load is. The dev auth stub sends `Bearer dev:<userId>`, and the demo backend
# seeds the same four ids the UI uses, so this is just a UserId. Switch at runtime with the
# DEMO pill in the bottom-left corner.
#
# The Tea Party, as seeded: kristina | esh | sabina | madhav
NEXT_PUBLIC_DEV_USER_ID=kristina
