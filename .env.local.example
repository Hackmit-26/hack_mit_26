# Copy to .env.local. Both values are inlined into the client bundle at build time.

# Where the Fastify backend is listening.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Seeds the viewer on page load. The backend's dev auth stub accepts `Bearer dev:<userUuid>`,
# so this must be a real app_users.id from Supabase. Switch users at runtime with
# setViewer(userId) from @/lib/api.
#
# The Tea Party, as seeded: Kristina 1111...., Esh 2222...., Sabina 3333...., Madhav 4444....
NEXT_PUBLIC_DEV_USER_ID=11111111-1111-1111-1111-111111111111
