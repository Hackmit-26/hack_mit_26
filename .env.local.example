# Copy to .env.local. Both values are inlined into the client bundle at build time.

# Where the Fastify backend is listening.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Seeds the viewer on page load. The backend's dev auth stub accepts `Bearer dev:<userUuid>`,
# so this must be a real users.id from Supabase. Switch users at runtime with
# setViewer(userId) from @/lib/api.
NEXT_PUBLIC_DEV_USER_ID=
